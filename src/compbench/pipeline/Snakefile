# Generated with Claude Code 2.1.234 / Claude Opus 4.7 (1M context)
#
# Snakemake orchestration around `duct compbench run …`. The Snakefile is
# intentionally thin: enumerate cells from a profile YAML, shell one
# duct-wrapped compbench invocation per cell, then aggregate.
#
# Usage:
#   snakemake -s src/compbench/pipeline/Snakefile \
#       --configfile configs/profiles/smoke.yaml \
#       --cores 4 \
#       [--use-apptainer | --use-singularity]
#
# The `container:` directives use `docker://…` — Snakemake transparently
# handles conversion to `.sif` at runtime on HPC when invoked with
# `--use-apptainer` / `--use-singularity`.

import shlex
from pathlib import Path

from compbench.pipeline.profile import load_profile, expand_matrix


# ---- Config ---------------------------------------------------------------

# `--profile /path/to.yaml` loads by path; `--configfile /path/to.yaml`
# hands us the parsed dict directly. `load_profile` accepts both and
# runs the same schema validation on either.
if "profile" in config:
    _profile = load_profile(config["profile"])
else:
    _profile = load_profile(dict(config))

RESULTS_DIR = Path(config.get("results_dir", f"results/{_profile.name}"))
CELLS = list(expand_matrix(_profile))
CELL_BY_ID = {c.cell_id: c for c in CELLS}

# Early validation — fail up front with a readable message if any cell asks
# for a codec that isn't registered on this host (e.g. wavpack-numcodecs
# missing due to glibc mismatch; t261 missing because src/bwc/ isn't built).
from compbench import codecs as _cbcodecs

_available = set(_cbcodecs.names())
_missing = sorted({c.codec for c in CELLS if c.codec not in _available})
if _missing:
    raise WorkflowError(
        f"Profile requests codec(s) not registered on this host: {_missing}.\n"
        f"Available codecs: {sorted(_available)}\n"
        f"Fix by installing the codec's extras (e.g. `pip install -e .[audio]` for "
        f"wavpack; `cmake --build src/bwc/build` for t261) — see plan §4.2 / §5."
    )

CONTAINER_BASE = config.get(
    "container_base", "docker://ghcr.io/allenneuraldynamics/aind-ephys-pipeline-base:si-0.103.0"
)

# ---- Wildcards & I/O ------------------------------------------------------

RESULTS_DIR.mkdir(parents=True, exist_ok=True)


def _cell_dir(cell_id: str) -> str:
    return str(RESULTS_DIR / cell_id)


rule all:
    """Terminal target — every cell attempts, aggregation runs post-hook.

    We depend on the per-cell metrics rather than on `report.parquet`
    because report.parquet needs to be produced AFTER all cells attempt
    (whether they succeed or fail with --keep-going). The `onsuccess` and
    `onerror` handlers below run the aggregator unconditionally at the end,
    so a partial sweep still yields the report on whatever cells landed.
    """
    input:
        [RESULTS_DIR / c.cell_id / "metrics.json" for c in CELLS],


onsuccess:
    shell(
        r"compbench report --results-dir {RESULTS_DIR} --output "
        r"{RESULTS_DIR}/report.parquet && "
        r"compbench render-report --parquet {RESULTS_DIR}/report.parquet "
        r"--output {RESULTS_DIR}/AUTO_TABLE.md "
        r"--title 'Sweep report' --source-note 'Auto-rendered post-sweep.'"
    )


onerror:
    # Aggregate whatever succeeded before the failure — useful when
    # --keep-going lets N-1 cells complete but one hard-fails.
    shell(
        r"compbench report --results-dir {RESULTS_DIR} --output "
        r"{RESULTS_DIR}/report.parquet 2>/dev/null || true; "
        r"compbench render-report --parquet {RESULTS_DIR}/report.parquet "
        r"--output {RESULTS_DIR}/AUTO_TABLE.md "
        r"--title 'Sweep report (partial)' "
        r"--source-note 'One or more cells failed; report contains successful cells only.' "
        r"2>/dev/null || true"
    )


rule run_cell:
    """One duct-wrapped `compbench run` invocation → metrics.json + duct-*.

    Profile YAMLs are untrusted (per plan §9.5 — DICOM WG-32 members drop
    them in), so all fields interpolated into the shell command are
    quoted with `shlex.quote` before rendering. The dataset_spec /
    codec_name / codec_params_cli / cell_dir strings can therefore contain
    quotes, spaces, or shell metacharacters without breaking or exploiting
    the command line.
    """
    output:
        metrics = RESULTS_DIR / "{cell_id}" / "metrics.json",
        manifest = RESULTS_DIR / "{cell_id}" / "manifest.json",
        duct_info = RESULTS_DIR / "{cell_id}" / "duct-info.json",
    params:
        cell_dir = lambda w: _cell_dir(w.cell_id),
        cell_dir_q = lambda w: shlex.quote(_cell_dir(w.cell_id)),
        input_q = lambda w: shlex.quote(CELL_BY_ID[w.cell_id].dataset_spec),
        codec_q = lambda w: shlex.quote(CELL_BY_ID[w.cell_id].codec),
        params_q = lambda w: shlex.quote(CELL_BY_ID[w.cell_id].codec_params_cli),
    threads: 1
    resources:
        mem_mb = 4096,
        time_min = 30,
    # container: CONTAINER_BASE   # opt-in — comment out for host-native runs
    shell:
        r"""
        mkdir -p {params.cell_dir_q}
        duct \
            --output-prefix {params.cell_dir_q}/duct- \
            --sample-interval 1 \
            --report-interval 5 \
            compbench run \
                --input {params.input_q} \
                --codec {params.codec_q} \
                --codec-params {params.params_q} \
                --output-dir {params.cell_dir_q}
        """


# Note: `rule aggregate` is deliberately absent. Aggregation runs as
# `onsuccess`/`onerror` above so it fires exactly once at the end of a
# sweep, after every cell has been attempted, regardless of whether
# --keep-going swallowed some failures. If you want to aggregate ad-hoc
# outside a sweep, invoke `compbench report` + `compbench render-report`
# directly — see DEPLOY.md §5.
