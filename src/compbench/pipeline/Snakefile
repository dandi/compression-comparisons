# Generated with Claude Code 2.1.234 / Claude Opus 4.7 (1M context)
#
# Snakemake orchestration around `duct compbench run …`. The Snakefile is
# intentionally thin: enumerate cells from a profile YAML, shell one
# duct-wrapped compbench invocation per cell, then aggregate.
#
# Usage:
#   snakemake -s src/compbench/pipeline/Snakefile \
#       --configfile configs/profiles/smoke.yaml \
#       --cores 4 \
#       [--use-apptainer | --use-singularity]
#
# The `container:` directives use `docker://…` — Snakemake transparently
# handles conversion to `.sif` at runtime on HPC when invoked with
# `--use-apptainer` / `--use-singularity`.

import os
import shlex
from pathlib import Path

from compbench.pipeline.profile import load_profile, expand_matrix


# ---- Scratch volume -------------------------------------------------------
#
# Codec adapters that shell out (T.261) stage a raw + encoded copy of every
# in-flight cell through TMPDIR. Python defaults that to /tmp, which on a
# container host is typically the small root overlay — filling it takes down
# far more than the sweep. Resolve it here so the guarantee holds however the
# workflow was invoked, not only via `make`.
#
# Precedence: an explicit TMPDIR in the environment wins (HPC node-local
# scratch), then COMPBENCH_TMPDIR from .env, then a `.tmp` beside the repo.
def _resolve_tmpdir() -> str:
    explicit = os.environ.get("TMPDIR")
    if explicit:
        return str(Path(explicit).resolve())
    repo_root = Path(workflow.basedir).resolve().parents[2]
    for line in (repo_root / ".env").read_text().splitlines() if (repo_root / ".env").is_file() else []:
        line = line.strip()
        if line.startswith("COMPBENCH_TMPDIR="):
            value = line.split("=", 1)[1].strip()
            candidate = Path(value)
            return str(candidate if candidate.is_absolute() else (repo_root / candidate).resolve())
    return str((repo_root / ".tmp").resolve())


TMPDIR = _resolve_tmpdir()
Path(TMPDIR).mkdir(parents=True, exist_ok=True)
os.environ["TMPDIR"] = TMPDIR

# Blosc is nondeterministic above one thread (same length, different bytes)
# and would put `--cores N` x 8 threads on the box while every rule declares
# `threads: 1`. Parallelism belongs at the cell level.
os.environ.setdefault("COMPBENCH_BLOSC_THREADS", "1")


# ---- WavPack --------------------------------------------------------------
#
# `wavpack-numcodecs` loads libwavpack at import time. When it was built
# against a vendored prefix (scripts/build_wavpack.sh) that prefix has to be on
# the loader path, or `import wavpack_numcodecs` fails and the codec silently
# does not register — which the Snakefile's codec check would then report as
# "codec not registered on this host", pointing at the wrong problem.
def _wavpack_prefix() -> str | None:
    repo_root = Path(workflow.basedir).resolve().parents[2]
    configured = os.environ.get("COMPBENCH_WAVPACK_PREFIX")
    if configured is None and (repo_root / ".env").is_file():
        for line in (repo_root / ".env").read_text().splitlines():
            line = line.strip()
            if line.startswith("COMPBENCH_WAVPACK_PREFIX="):
                configured = line.split("=", 1)[1].strip()
                break
    if not configured:
        return None
    p = Path(configured)
    p = p if p.is_absolute() else (repo_root / p)
    return str(p.resolve()) if (p / "bin" / "wavpack").exists() else None


# Captured BEFORE the mutation below: the loader only honours what was set at
# process start, so this is the value that actually decided whether the
# extension could load.
LD_PATH_AT_START = os.environ.get("LD_LIBRARY_PATH", "")
WAVPACK_PREFIX = _wavpack_prefix()
WAVPACK_EXPORT = (
    f'export PATH={shlex.quote(WAVPACK_PREFIX + "/bin")}:"$PATH"; '
    f'export LD_LIBRARY_PATH={shlex.quote(WAVPACK_PREFIX + "/lib")}:"${{LD_LIBRARY_PATH:-}}"'
) if WAVPACK_PREFIX else ":"
if WAVPACK_PREFIX:
    os.environ["PATH"] = f"{WAVPACK_PREFIX}/bin:" + os.environ.get("PATH", "")
    os.environ["LD_LIBRARY_PATH"] = (
        f"{WAVPACK_PREFIX}/lib:" + os.environ.get("LD_LIBRARY_PATH", "")
    )


# ---- Config ---------------------------------------------------------------

# `--profile /path/to.yaml` loads by path; `--configfile /path/to.yaml`
# hands us the parsed dict directly. `load_profile` accepts both and
# runs the same schema validation on either.
if "profile" in config:
    _profile = load_profile(config["profile"])
else:
    # `--configfile` hands us the parsed dict and drops the filename, but
    # relative dataset paths in the profile need it as their anchor —
    # a paper sweep runs from the STAMPED study root, not the tool repo.
    _configfiles = list(getattr(workflow, "configfiles", []) or [])
    _base_dir = Path(_configfiles[0]).resolve().parent if _configfiles else None
    _profile = load_profile(dict(config), base_dir=_base_dir)

RESULTS_DIR = Path(config.get("results_dir", f"results/{_profile.name}"))
CELLS = list(expand_matrix(_profile, generated_dir=RESULTS_DIR / "generated-datasets"))
CELL_BY_ID = {c.cell_id: c for c in CELLS}

# Early validation — fail up front with a readable message if any cell asks
# for a codec that isn't registered on this host (e.g. wavpack-numcodecs
# missing due to glibc mismatch; t261 missing because src/bwc/ isn't built).
from compbench import codecs as _cbcodecs

_available = set(_cbcodecs.names())
_missing = sorted({c.codec for c in CELLS if c.codec not in _available})
if _missing:
    _hint = (
        "Fix by installing the codec's extras (e.g. `pip install -e .[audio]` for "
        "wavpack; `cmake --build src/bwc/build` for t261) — see plan §4.2 / §5."
    )
    # A vendored libwavpack that the loader cannot see produces exactly the
    # same symptom as a codec that was never installed, and sends you looking
    # in the wrong place. LD_LIBRARY_PATH is read at process start, so setting
    # it from inside this file is too late for our own import — say so.
    if (
        "wavpack" in _missing
        and WAVPACK_PREFIX
        and f"{WAVPACK_PREFIX}/lib" not in LD_PATH_AT_START
    ):
        _hint = (
            f"`wavpack-numcodecs` IS installed and a libwavpack build exists at\n"
            f"  {WAVPACK_PREFIX}\n"
            f"but the dynamic loader cannot see it. LD_LIBRARY_PATH is read at "
            f"process start, so this Snakefile cannot fix it for its own import.\n"
            f"Run the sweep through `make`, which exports it, or set it yourself:\n"
            f"  export LD_LIBRARY_PATH={WAVPACK_PREFIX}/lib:$LD_LIBRARY_PATH"
        )
    raise WorkflowError(
        f"Profile requests codec(s) not registered on this host: {_missing}.\n"
        f"Available codecs: {sorted(_available)}\n" + _hint
    )

# ---- Per-cell provenance (`datalad run`) ----------------------------------
#
# Each cell records its own `datalad run` commit, nested inside the one the
# sweep driver wraps around snakemake. That needs datalad with the gh-7899 /
# gh-7900 fixes (see .specify/specs/datalad-pin.md): released datalad loses
# records under concurrency and rejects nested runs outright. `run_sweep.sh`
# enforces the pin; this file only decides whether to emit the records.
#
# `datalad_run` config: "auto" (default) enables it when the results land
# inside a datalad dataset whose root is the CWD, "yes"/"no" force it. The
# CWD condition is deliberate — every path handed to `datalad run` below is
# relative, and that is only unambiguous when snakemake was invoked from the
# dataset root, which is how DEPLOY documents a sweep.
def _dataset_root_for(path: Path) -> Path | None:
    for cand in [path.resolve(), *path.resolve().parents]:
        if (cand / ".datalad" / "config").is_file():
            return cand
    return None


_dl_setting = str(config.get("datalad_run", "auto")).lower()
_dl_root = _dataset_root_for(RESULTS_DIR)
if _dl_setting in ("no", "false", "0", "off"):
    DATALAD_RUN = False
elif _dl_setting in ("yes", "true", "1", "on"):
    if _dl_root is None or _dl_root != Path.cwd().resolve():
        raise WorkflowError(
            "datalad_run=yes, but results_dir is not inside a datalad dataset "
            f"rooted at the CWD (dataset root: {_dl_root}, cwd: {Path.cwd()})."
        )
    DATALAD_RUN = True
else:
    DATALAD_RUN = _dl_root is not None and _dl_root == Path.cwd().resolve()


def _cell_inputs(cell) -> list[str]:
    """Declared `--input`s for a cell: its dataset YAML and the data it names.

    Only paths inside the dataset are declared; anything else is not ours to
    fetch or to judge. The recording path is read straight from the loader
    spec (`params.path`) rather than resolved through the loader, which would
    mean importing and instantiating it here just to learn a filename.
    """
    if not DATALAD_RUN:
        return []
    root = Path.cwd().resolve()
    out: list[str] = []

    def _add(candidate) -> None:
        try:
            rel = Path(candidate).resolve().relative_to(root)
        except (ValueError, OSError):
            return
        if Path(candidate).exists() and str(rel) not in out:
            out.append(str(rel))

    spec = Path(cell.dataset_spec)
    _add(spec)
    if spec.suffix in (".yaml", ".yml") and spec.is_file():
        try:
            import yaml as _yaml

            doc = _yaml.safe_load(spec.read_text()) or {}
            data_path = (doc.get("params") or {}).get("path")
        except Exception:
            data_path = None
        if data_path:
            # relative to the dataset YAML's own directory or to the CWD,
            # matching how the loaders themselves resolve it
            for base in (root, spec.parent):
                cand = Path(data_path)
                cand = cand if cand.is_absolute() else base / cand
                if cand.exists():
                    _add(cand)
                    break
    return out


def _portable(spec: str) -> str:
    """Rewrite a path inside the dataset as relative to it.

    `_resolve_dataset_spec` hands back an absolute path when it found the
    dataset YAML by walking up from the profile. Recording that verbatim
    would bake this machine's layout into the run record, so a `rerun` in
    any other clone would fail. Paths outside the dataset are left alone:
    they are not ours to rewrite, and a relative form would be wrong.
    """
    if not DATALAD_RUN:
        return spec
    try:
        return str(Path(spec).resolve().relative_to(Path.cwd().resolve()))
    except (ValueError, OSError):
        return spec


def _run_cmd(cell_id: str) -> str:
    """The command line for one cell, optionally wrapped in `datalad run`.

    The inner command is passed to `datalad run` as ONE quoted argument.
    Passing it as separate tokens would let datalad's own parser consume the
    `--input` / `--output` that belong to `compbench run`.
    """
    cell = CELL_BY_ID[cell_id]
    cell_dir = _cell_dir(cell_id)
    chunk_arg = (
        ""
        if cell.chunk_duration_s is None
        else f" --chunk-duration-s {shlex.quote(str(cell.chunk_duration_s))}"
    )
    inner = (
        # --clobber so the recorded command is replayable: `datalad rerun`
        # of a cell re-executes into a directory that already holds duct's
        # own files from the original run, and duct refuses to overwrite
        # them otherwise. A no-op on a fresh sweep, where the cell
        # directory is this rule's own output and starts empty.
        f"duct --clobber --output-prefix {shlex.quote(cell_dir)}/duct-"
        f" --sample-interval 1 --report-interval 5"
        f" compbench run"
        f" --input {shlex.quote(_portable(cell.dataset_spec))}"
        f" --codec {shlex.quote(cell.codec)}"
        f" --codec-params {shlex.quote(cell.codec_params_cli)}"
        f"{chunk_arg}"
        f" --output-dir {shlex.quote(cell_dir)}"
    )
    if not DATALAD_RUN:
        return inner
    args = ["datalad", "run", "--explicit", "--output", cell_dir]
    for ip in _cell_inputs(cell):
        args += ["--input", ip]
    args += [
        "-m",
        f"cell {cell_id}: {cell.codec}"
        + (f" [{cell.codec_params_cli}]" if cell.codec_params_cli else "")
        + f" on {cell.dataset_label or cell.dataset_spec}",
        inner,
    ]
    return " ".join(shlex.quote(a) for a in args)


CONTAINER_BASE = config.get(
    "container_base", "docker://ghcr.io/allenneuraldynamics/aind-ephys-pipeline-base:si-0.103.0"
)

# ---- Wildcards & I/O ------------------------------------------------------

RESULTS_DIR.mkdir(parents=True, exist_ok=True)


def _cell_dir(cell_id: str) -> str:
    return str(RESULTS_DIR / cell_id)


rule all:
    """Terminal target — every cell attempts, aggregation runs post-hook.

    We depend on the per-cell metrics rather than on `report.parquet`
    because report.parquet needs to be produced AFTER all cells attempt
    (whether they succeed or fail with --keep-going). The `onsuccess` and
    `onerror` handlers below run the aggregator unconditionally at the end,
    so a partial sweep still yields the report on whatever cells landed.
    """
    input:
        [RESULTS_DIR / c.cell_id / "metrics.json" for c in CELLS],


onsuccess:
    shell(
        r"compbench report --results-dir {RESULTS_DIR} --output "
        r"{RESULTS_DIR}/report.parquet && "
        r"compbench render-report --parquet {RESULTS_DIR}/report.parquet "
        r"--output {RESULTS_DIR}/AUTO_TABLE.md "
        r"--title 'Sweep report' --source-note 'Auto-rendered post-sweep.'"
    )


onerror:
    # Aggregate whatever succeeded before the failure — useful when
    # --keep-going lets N-1 cells complete but one hard-fails.
    shell(
        r"compbench report --results-dir {RESULTS_DIR} --output "
        r"{RESULTS_DIR}/report.parquet 2>/dev/null || true; "
        r"compbench render-report --parquet {RESULTS_DIR}/report.parquet "
        r"--output {RESULTS_DIR}/AUTO_TABLE.md "
        r"--title 'Sweep report (partial)' "
        r"--source-note 'One or more cells failed; report contains successful cells only.' "
        r"2>/dev/null || true"
    )


rule run_cell:
    """One duct-wrapped `compbench run` invocation → metrics.json + duct-*.

    Profile YAMLs are untrusted (per plan §9.5 — DICOM WG-32 members drop
    them in), so all fields interpolated into the shell command are
    quoted with `shlex.quote` before rendering. The dataset_spec /
    codec_name / codec_params_cli / cell_dir strings can therefore contain
    quotes, spaces, or shell metacharacters without breaking or exploiting
    the command line.
    """
    output:
        metrics = RESULTS_DIR / "{cell_id}" / "metrics.json",
        manifest = RESULTS_DIR / "{cell_id}" / "manifest.json",
        duct_info = RESULTS_DIR / "{cell_id}" / "duct-info.json",
    params:
        cell_dir_q = lambda w: shlex.quote(_cell_dir(w.cell_id)),
        run_cmd = lambda w: _run_cmd(w.cell_id),
    threads: 1
    resources:
        mem_mb = 4096,
        time_min = 30,
    # container: CONTAINER_BASE   # opt-in — comment out for host-native runs
    shell:
        r"""
        export TMPDIR={TMPDIR:q}
        export COMPBENCH_BLOSC_THREADS="${{COMPBENCH_BLOSC_THREADS:-1}}"
        {WAVPACK_EXPORT}
        mkdir -p {params.cell_dir_q}
        {params.run_cmd}
        """


# Note: `rule aggregate` is deliberately absent. Aggregation runs as
# `onsuccess`/`onerror` above so it fires exactly once at the end of a
# sweep, after every cell has been attempted, regardless of whether
# --keep-going swallowed some failures. If you want to aggregate ad-hoc
# outside a sweep, invoke `compbench report` + `compbench render-report`
# directly — see DEPLOY.md §5.
