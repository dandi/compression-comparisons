# Environment for compbench sweeps — committed on purpose.
#
# Source it before running anything that shells out to a codec:
#     set -a && . ./.env && set +a
# `make` targets and the Snakefile do this for you.

# ---------------------------------------------------------------------------
# TMPDIR — where codec subprocesses stage their scratch files.
#
# The T.261 adapter round-trips through files (`tempfile.TemporaryDirectory`),
# so every in-flight cell holds a raw + encoded copy of its input on disk. At
# a 60 s slice that is ~1.5 GB per cell; at 21-way parallelism, ~30-60 GB
# concurrently, and a full-length cell is 20x that.
#
# Python defaults TMPDIR to /tmp, which on a container host is usually the
# root overlay — small, shared, and fatal to more than this sweep if it
# fills. Keep scratch on the same large volume as the results instead.
#
# Relative to the repo root; `make` and the Snakefile resolve it to an
# absolute path and create it. Override with an absolute path to put scratch
# on a different volume (e.g. a node-local NVMe on HPC).
COMPBENCH_TMPDIR=.tmp

# ---------------------------------------------------------------------------
# Blosc thread count.
#
# Multi-threaded blosc is NONDETERMINISTIC: at nthreads>1 the same input
# produces a different compressed byte stream on every run (identical length,
# so CR is unaffected, and round-trip stays exact — but the artifact is not
# reproducible). At nthreads=1 it is byte-for-byte deterministic.
#
# It also keeps Snakemake's accounting honest: the run_cell rule declares
# `threads: 1`, but blosc defaults to 8, so `--cores 21` would put ~168
# threads on the box and make every wall-time and xRT measurement a function
# of how many neighbours happened to be running.
#
# Parallelism belongs at the cell level (`--cores N`), not inside the codec.
COMPBENCH_BLOSC_THREADS=1
